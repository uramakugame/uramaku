# Local development works with npm start and no environment file.
# Set these in Railway's Variables panel; npm start does not read .env itself.
NODE_ENV=production
HOST=0.0.0.0
SQLITE_PATH=/data/uramaku.sqlite
# PORT is injected by Railway. The volume mount path is /data.
# Optional: comma-separated HTTPS page origins. Empty means same-origin browsers.
ALLOWED_ORIGINS=
# Railway HTTP edge only: set TRUST_RAILWAY_PROXY=1 to use its X-Real-IP header.
# Leave off for localhost/ngrok or direct ingress. Do not combine both modes.
TRUST_RAILWAY_PROXY=0
# For a different verified fixed X-Forwarded-For proxy path, use this instead.
TRUSTED_PROXY_HOPS=0
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=10
RAILWAY_DEPLOYMENT_OVERLAP_SECONDS=0
# Existing application rate/room caps keep their tested defaults.
